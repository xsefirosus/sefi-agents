# Obsidian Bases view: topic -> note count over memory/sessions. Additive to ripgrep; the
# Memory Journalist uses it as a one-glance retrieval aid. Requires Obsidian
# Bases.
# Bases cannot natively count "3+ notes linking to the same target"; it groups by the
# shared topic field instead.
filters:
  and:
    - file.inFolder("memory/sessions")
properties:
  topic:
    displayName: Topic
views:
  - type: table
    name: Promotion candidates
    groupBy: topic
    summaries:
      topic: Unique
    order:
      - topic
